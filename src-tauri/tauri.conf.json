{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DM8 Export Tool",
  "version": "0.1.0",
  "identifier": "com.dm8.export",
  "build": {
    "beforeDevCommand": "cd ../frontend && npm run dev -- --host --port 5173",
    "beforeBuildCommand": "cd ../frontend && npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../frontend/dist"
  },
  "bundle": {
    "targets": ["appimage", "deb", "nsis"],
    "resources": {
      "../drivers/dm8": "drivers/dm8"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "nsis/hooks.nsh"
      }
    },
    "linux": {
      "deb": {
        "depends": ["unixodbc"]
      }
    }
  },
  "app": {
    "windows": [
      {
        "title": "DM8 Export Tool",
        "width": 1024,
        "height": 768
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; connect-src 'self' http://localhost:* http://127.0.0.1:*; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline';"
    }
  }
}
