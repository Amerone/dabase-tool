[workspace]

[package]
name = "shentong"
version = "0.5.7"
authors = ["liuyongsheng <lys6676@163.com>"]
build = "build.rs"
repository = "https://github.com/lys-st/rust-shentong"
license = "UPL-1.0/Apache-2.0"
keywords = ["shentong", "database"]
readme = "README.md"
description = "ShenTong binding"
edition = "2018"

[package.metadata.docs.rs]
all-features = true

[features]
aq_unstable = []

[dependencies]
lazy_static = "1.3.0"
paste = "1.0.5"
oracle_procmacro = { version = "0.1", path = "./oracle_procmacro" }

[build-dependencies]
cc = "1.0"

[dev-dependencies]
uuid = "0.8"
